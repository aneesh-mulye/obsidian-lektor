{
  "name": "obsidian-lektor",
  "version": "0.1.4",
  "description": "An Obsidian sidebar chat that sees only the context you give it and changes nothing without per-hunk approval.",
  "main": "main.js",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Aneesh Mulye",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "CI=1 vitest run",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "markdown-it": "15.0.3",
    "mdurl": "2.1.0",
    "picomatch": "4.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.4",
    "@types/picomatch": "4.0.3",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-obsidianmd": "0.6.0",
    "fast-check": "4.11.0",
    "obsidian": "1.14.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "yaml": "2.9.1"
  }
}
